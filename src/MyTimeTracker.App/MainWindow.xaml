<Window x:Class="MyTimeTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MyTimeTracker.App.Resources"
        xmlns:vm="clr-namespace:MyTimeTracker.App.ViewModels"
        Title="{ui:Loc Key=AppTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="424"
        Height="680"
        MinWidth="390"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <DataTemplate x:Key="SessionRowTemplate" DataType="{x:Type vm:SessionRowViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    CornerRadius="11"
                    BorderThickness="1"
                    AutomationProperties.Name="{Binding StartEndText}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ManualRowBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource ManualRowBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StartEndText}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0"
                                    Padding="6,1"
                                    CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                <Setter Property="Background" Value="#F6E8CB" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BadgeText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Comment}"
                                   Margin="0,5,0,0"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DurationText}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource RowIconButtonStyle}"
                                    Command="{Binding EditCommand}"
                                    Content="&#xE70F;"
                                    ToolTip="{ui:Loc Key=EditEntry}"
                                    AutomationProperties.Name="{ui:Loc Key=EditEntry}" />
                            <Button Style="{StaticResource RowIconButtonStyle}"
                                    Command="{Binding DeleteCommand}"
                                    Content="&#xE74D;"
                                    Margin="2,0,0,0"
                                    Foreground="{StaticResource DangerBrush}"
                                    ToolTip="{ui:Loc Key=DeleteEntry}"
                                    AutomationProperties.Name="{ui:Loc Key=DeleteEntry}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact header -->
        <Grid Grid.Row="0" Margin="20,16,14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/app.ico"
                       Width="28"
                       Height="28"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
                <TextBlock Text="{Binding HeaderTitle}"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ShowHistoryCommand}"
                        Content="&#xE81C;"
                        ToolTip="{ui:Loc Key=TooltipHistory}"
                        AutomationProperties.Name="{ui:Loc Key=TooltipHistory}"
                        Visibility="{Binding IsTimerPage, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ShowTimerCommand}"
                        Content="&#xE72B;"
                        ToolTip="{ui:Loc Key=Back}"
                        AutomationProperties.Name="{ui:Loc Key=Back}"
                        Visibility="{Binding IsHistoryPage, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding OpenSettingsCommand}"
                        Content="&#xE713;"
                        Margin="2,0,0,0"
                        ToolTip="{ui:Loc Key=TooltipSettings}"
                        AutomationProperties.Name="{ui:Loc Key=TooltipSettings}" />
            </StackPanel>
        </Grid>

        <!-- Timer page -->
        <ScrollViewer Grid.Row="1"
                      Margin="20,2,20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsTimerPage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,0,0,22">
                <Border Style="{StaticResource CardStyle}" Padding="18,20,18,16">
                    <StackPanel>
                        <TextBlock Text="{Binding TimerText}"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="52"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.Name="{Binding TimerText}" />

                        <Border HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Background}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Dot}" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                            </StackPanel>
                        </Border>

                        <Button Content="{Binding PrimaryActionText}"
                                Command="{Binding PrimaryActionCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,18,0,0"
                                AutomationProperties.Name="{Binding PrimaryActionText}" />

                        <Button Content="{ui:Loc Key=Stop}"
                                Command="{Binding StopCommand}"
                                Style="{StaticResource StopButtonStyle}"
                                Margin="0,8,0,0"
                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{ui:Loc Key=Stop}" />

                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding IsCommentEnabled, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CommentTextBoxStyle}"
                                     MaxLength="1000"
                                     AutomationProperties.Name="{ui:Loc Key=CommentPlaceholder}" />
                            <TextBlock Text="{ui:Loc Key=CommentPlaceholder}"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommentText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{ui:Loc Key=Today}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TodayDateText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TodaySessionCountText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TodayTotalText}"
                                       FontFamily="Consolas"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{ui:Loc Key=SessionTotalLabel}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{ui:Loc Key=SessionsToday}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="2,18,0,9" />

                <ItemsControl ItemsSource="{Binding TodaySessions}"
                              ItemTemplate="{StaticResource SessionRowTemplate}" />

                <TextBlock Text="{ui:Loc Key=NoSessionsToday}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20,10,20,6"
                           Visibility="{Binding IsTodayEmpty, Converter={StaticResource BoolToVisibility}}" />

                <Button Command="{Binding AddManualCommand}"
                        Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        ToolTip="{ui:Loc Key=AddManualEntry}"
                        AutomationProperties.Name="{ui:Loc Key=AddManualEntry}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{ui:Loc Key=AddManualEntry}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- History page -->
        <ScrollViewer Grid.Row="1"
                      Margin="20,2,20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsHistoryPage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{ui:Loc Key=Loading}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,10"
                           Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding HistoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryDayViewModel}">
                            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DateText}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SessionCountText}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalText}"
                                                   FontFamily="Consolas"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Sessions}"
                                                  ItemTemplate="{StaticResource SessionRowTemplate}"
                                                  Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{ui:Loc Key=HistoryEmpty}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20,16,20,10"
                           Visibility="{Binding IsHistoryEmptyVisible, Converter={StaticResource BoolToVisibility}}" />

                <Button Command="{Binding LoadEarlierCommand}"
                        Style="{StaticResource LinkButtonStyle}"
                        Content="{ui:Loc Key=LoadEarlier}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,4" />

                <Button Command="{Binding AddManualCommand}"
                        Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        AutomationProperties.Name="{ui:Loc Key=AddManualEntry}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{ui:Loc Key=AddManualEntry}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
