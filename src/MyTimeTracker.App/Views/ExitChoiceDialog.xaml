<Window x:Class="MyTimeTracker.App.Views.ExitChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MyTimeTracker.App.Resources"
        Title="{ui:Loc Key=ExitTitle}"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{ui:Loc Key=ExitTitle}"
                   FontSize="19"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="{ui:Loc Key=ExitMessage}"
                   Margin="0,12,0,0"
                   FontSize="13.5"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <Button x:Name="StopAndExitButton"
                    Content="{ui:Loc Key=ExitStopAndExit}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,8"
                    IsDefault="True" />
            <Button x:Name="MinimizeButton"
                    Content="{ui:Loc Key=ExitMinimizeTray}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,8" />
            <Button x:Name="CancelButtonControl"
                    Content="{ui:Loc Key=CancelButton}"
                    Style="{StaticResource LinkButtonStyle}"
                    HorizontalAlignment="Center"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
