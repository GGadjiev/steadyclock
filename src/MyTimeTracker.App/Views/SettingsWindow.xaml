<Window x:Class="MyTimeTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MyTimeTracker.App.Resources"
        xmlns:controls="clr-namespace:MyTimeTracker.App.Views.Controls"
        Title="{ui:Loc Key=SettingsTitle}"
        Width="560"
        Height="700"
        MinWidth="470"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">
                <TextBlock Text="{ui:Loc Key=SettingsTitle}"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Margin="2,0,0,16" />

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc Key=SettingsSectionTimer}" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox IsChecked="{Binding IsAutomaticStartEnabled}"
                                  Content="{ui:Loc Key=AutoStartOnLaunch}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc Key=SettingsSectionIdle}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{ui:Loc Key=IdleThresholdSecondsLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding IdleThresholdSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.Name="{ui:Loc Key=IdleThresholdSecondsLabel}" />
                        <TextBlock Text="{ui:Loc Key=IdleThresholdHint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc Key=SettingsSectionTray}" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox IsChecked="{Binding CloseToTray}"
                                  Content="{ui:Loc Key=CloseToTray}" />
                        <CheckBox IsChecked="{Binding AutoStartWithWindows}"
                                  Content="{ui:Loc Key=AutoStartWindows}"
                                  Margin="0,10,0,0" />
                        <CheckBox IsChecked="{Binding LaunchInTrayOnAutoStart}"
                                  IsEnabled="{Binding AutoStartWithWindows}"
                                  Content="{ui:Loc Key=StartInTrayAuto}"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc Key=SettingsSectionHotkeys}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{ui:Loc Key=HotkeysHint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{ui:Loc Key=HotkeyToggle}"
                                       VerticalAlignment="Center" Margin="0,0,12,9" />
                            <controls:HotkeyTextBox Grid.Row="0" Grid.Column="1"
                                                    Style="{StaticResource InputTextBoxStyle}"
                                                    Hotkey="{Binding ToggleHotkey, Mode=TwoWay}"
                                                    Margin="0,0,0,9"
                                                    AutomationProperties.Name="{ui:Loc Key=HotkeyToggle}" />

                            <TextBlock Grid.Row="1" Text="{ui:Loc Key=HotkeyStop}"
                                       VerticalAlignment="Center" Margin="0,0,12,9" />
                            <controls:HotkeyTextBox Grid.Row="1" Grid.Column="1"
                                                    Style="{StaticResource InputTextBoxStyle}"
                                                    Hotkey="{Binding StopHotkey, Mode=TwoWay}"
                                                    Margin="0,0,0,9"
                                                    AutomationProperties.Name="{ui:Loc Key=HotkeyStop}" />

                            <TextBlock Grid.Row="2" Text="{ui:Loc Key=HotkeyShowHide}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <controls:HotkeyTextBox Grid.Row="2" Grid.Column="1"
                                                    Style="{StaticResource InputTextBoxStyle}"
                                                    Hotkey="{Binding ShowHideHotkey, Mode=TwoWay}"
                                                    AutomationProperties.Name="{ui:Loc Key=HotkeyShowHide}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc Key=SettingsSectionReminders}" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox IsChecked="{Binding RemindersEnabled}"
                                  Content="{ui:Loc Key=NotificationsEnabledLabel}" />
                        <StackPanel IsEnabled="{Binding RemindersEnabled}" Margin="0,12,0,0">
                            <CheckBox IsChecked="{Binding ForgotTimerReminderEnabled}"
                                      Content="{ui:Loc Key=ForgotTimerEnabledLabel}" />
                            <StackPanel IsEnabled="{Binding ForgotTimerReminderEnabled}" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{ui:Loc Key=RemindAfterMinutesLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,8" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding ForgotTimerAfterMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8"
                                             AutomationProperties.Name="{ui:Loc Key=RemindAfterMinutesLabel}" />
                                    <TextBlock Grid.Row="1" Text="{ui:Loc Key=RepeatNotFasterLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding ReminderRepeatMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{ui:Loc Key=RepeatNotFasterLabel}" />
                                </Grid>

                                <TextBlock Text="{ui:Loc Key=WorkDaysLabel}"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,16,0,6" />
                                <WrapPanel>
                                    <CheckBox Content="{ui:Loc Key=Monday}" IsChecked="{Binding Monday}" Margin="0,0,14,8" />
                                    <CheckBox Content="{ui:Loc Key=Tuesday}" IsChecked="{Binding Tuesday}" Margin="0,0,14,8" />
                                    <CheckBox Content="{ui:Loc Key=Wednesday}" IsChecked="{Binding Wednesday}" Margin="0,0,14,8" />
                                    <CheckBox Content="{ui:Loc Key=Thursday}" IsChecked="{Binding Thursday}" Margin="0,0,14,8" />
                                    <CheckBox Content="{ui:Loc Key=Friday}" IsChecked="{Binding Friday}" Margin="0,0,14,8" />
                                    <CheckBox Content="{ui:Loc Key=Saturday}" IsChecked="{Binding Saturday}" Margin="0,0,14,8" />
                                    <CheckBox Content="{ui:Loc Key=Sunday}" IsChecked="{Binding Sunday}" Margin="0,0,0,8" />
                                </WrapPanel>

                                <TextBlock Text="{ui:Loc Key=WorkHoursLabel}"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,8,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="92">
                                        <TextBlock Text="{ui:Loc Key=WorkStartLabel}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{ui:Loc Key=WorkStartLabel}" />
                                    </StackPanel>
                                    <TextBlock Text="—"
                                               Margin="10,22,10,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Width="92">
                                        <TextBlock Text="{ui:Loc Key=WorkEndLabel}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{ui:Loc Key=WorkEndLabel}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource DangerSoftBrush}"
                CornerRadius="9"
                Padding="12,9"
                Margin="24,0,24,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Button Content="{ui:Loc Key=ResetSettings}"
                        Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="ResetButton_Click"
                        Foreground="{StaticResource DangerBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{ui:Loc Key=CancelButton}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            MinWidth="104"
                            Margin="0,0,10,0" />
                    <Button Content="{ui:Loc Key=SaveButton}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Height="40"
                            MinWidth="120" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
