<Window x:Class="MyTimeTracker.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MyTimeTracker.App.Resources"
        Width="370"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        UseLayoutRounding="True">
    <Border Margin="12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Direction="270"
                              Color="#24312D"
                              Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="14,0,0,14" />
            <Grid Grid.Column="1" Margin="15,13,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="ToastTitleText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,28,0"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Width="26"
                            Height="26"
                            FontSize="11"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Content="&#xE711;"
                            ToolTip="{ui:Loc Key=Close}"
                            AutomationProperties.Name="{ui:Loc Key=Close}"
                            Click="CloseButton_Click" />
                </Grid>

                <TextBlock x:Name="ToastMessageText"
                           Grid.Row="1"
                           Margin="0,7,4,0"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="ActionsPanel"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,13,0,0">
                    <Button x:Name="SecondaryActionButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32"
                            MinWidth="84"
                            FontSize="12.5"
                            Margin="0,0,8,0"
                            Click="SecondaryActionButton_Click" />
                    <Button x:Name="PrimaryActionButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="32"
                            MinWidth="98"
                            FontSize="12.5"
                            Click="PrimaryActionButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
