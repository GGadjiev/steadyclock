<Window x:Class="MyTimeTracker.App.Views.SessionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MyTimeTracker.App.Resources"
        Title="{Binding Title}"
        Width="470"
        Height="590"
        MinWidth="400"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">
                <TextBlock Text="{Binding Title}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc Key=DateLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding SelectedDate}"
                                    SelectedDateFormat="Short"
                                    HorizontalAlignment="Left"
                                    Width="180"
                                    AutomationProperties.Name="{ui:Loc Key=DateLabel}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{ui:Loc Key=StartTimeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         MaxLength="5"
                                         AutomationProperties.Name="{ui:Loc Key=StartTimeLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{ui:Loc Key=EndTimeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         MaxLength="5"
                                         AutomationProperties.Name="{ui:Loc Key=EndTimeLabel}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{ui:Loc Key=EndTimeHint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DurationPreview}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="{Binding AutoConversionNote}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsAutomaticExisting, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc Key=CommentLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MultilineTextBoxStyle}"
                                 MaxLength="1000"
                                 AutomationProperties.Name="{ui:Loc Key=CommentLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource DangerSoftBrush}"
                CornerRadius="9"
                Padding="12,9"
                Margin="24,0,24,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{ui:Loc Key=CancelButton}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        MinWidth="104"
                        Margin="0,0,10,0" />
                <Button Content="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Height="40"
                        MinWidth="120" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
