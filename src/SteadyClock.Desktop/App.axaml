<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SteadyClock.Desktop.App"
             Name="SteadyClock"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SteadyClock/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>

