<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteadyClock.Desktop.ViewModels"
        xmlns:controls="using:SteadyClock.Desktop.Views.Controls"
        xmlns:loc="using:SteadyClock.Desktop.Resources"
        x:Class="SteadyClock.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Loc Key=AppTitle}"
        Icon="avares://SteadyClock/Assets/app.ico"
        Width="540"
        Height="840"
        MinWidth="460"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="SessionRowTemplate" x:DataType="vm:SessionLineViewModel">
            <Border BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,11">
                <Grid ColumnDefinitions="18,*,Auto,Auto">
                    <Grid Grid.Column="0">
                        <Border Width="1"
                                Background="{DynamicResource DividerBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Margin="0,12,0,-11" />
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{DynamicResource SageBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding TimeRangeText}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <Border Classes="badge" IsVisible="{Binding HasBadge}">
                                <TextBlock Text="{Binding Badge}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Comment}"
                                   Classes="caption"
                                   IsVisible="{Binding HasComment}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationText}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="12,0,6,0" />

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanManage}">
                        <Button Classes="rowAction"
                                Command="{Binding EditCommand}"
                                AutomationProperties.Name="{Binding EditLabel}">
                            <ToolTip.Tip>
                                <TextBlock Text="{Binding EditLabel}" Foreground="White" />
                            </ToolTip.Tip>
                            <PathIcon Width="13"
                                      Height="13"
                                      Foreground="{Binding $parent[Button].Foreground}"
                                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25Z" />
                        </Button>
                        <Button Classes="rowAction"
                                Command="{Binding DeleteCommand}"
                                AutomationProperties.Name="{Binding DeleteLabel}">
                            <ToolTip.Tip>
                                <TextBlock Text="{Binding DeleteLabel}" Foreground="White" />
                            </ToolTip.Tip>
                            <PathIcon Width="13"
                                      Height="13"
                                      Foreground="{Binding $parent[Button].Foreground}"
                                      Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Margin="24,18,24,10" ColumnDefinitions="Auto,*,Auto">
            <Image Width="40"
                   Height="40"
                   Source="avares://SteadyClock/Assets/app.png"
                   VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="11,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Key=AppTitle}" Classes="brand" />
                <Border Classes="pill" Padding="9,2">
                    <TextBlock Text="beta"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="nav"
                        Content="{loc:Loc Key=HistoryTitle}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding ShowHistoryCommand}"
                        IsVisible="{Binding IsTimerPage}" />
                <Button Classes="nav"
                        Content="{loc:Loc Key=Back}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding ShowTimerCommand}"
                        IsVisible="{Binding IsHistoryPage}" />
                <Button Classes="icon"
                        Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="{loc:Loc Key=SettingsOpenTooltip}">
                    <ToolTip.Tip>
                        <TextBlock Text="{loc:Loc Key=SettingsOpenTooltip}" Foreground="White" />
                    </ToolTip.Tip>
                    <PathIcon Width="18"
                              Height="18"
                              Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98M12,15.5A3.5,3.5 0 1,1 15.5,12A3.5,3.5 0 0,1 12,15.5Z" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="TimerScroll"
                      Grid.Row="1"
                      Margin="24,0,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsTimerPage}">
            <StackPanel x:Name="TimerContent" Margin="0,0,10,18">
                <Border Classes="card" Padding="20,18,20,18" ClipToBounds="True">
                    <Grid>
                        <controls:RingsBackground RingBrush="{DynamicResource RingBrush}"
                                                  Opacity="0.35"
                                                  IsHitTestVisible="False" />
                        <StackPanel Margin="4,0">
                            <TextBlock Text="{Binding TimerText}" Classes="timer" />
                            <Border HorizontalAlignment="Center"
                                    Margin="0,4,0,0"
                                    Padding="12,5"
                                    CornerRadius="999"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Background}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7"
                                             Height="7"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Dot}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding PrimaryActionCommand}"
                                    Classes="primary"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Width="14"
                                              Height="14"
                                              Data="{Binding PrimaryActionIconData}" />
                                    <TextBlock Text="{Binding PrimaryActionText}" />
                                </StackPanel>
                            </Button>

                            <Button Content="{loc:Loc Key=Stop}"
                                    Command="{Binding StopCommand}"
                                    Classes="secondary"
                                    HorizontalAlignment="Center"
                                    MinWidth="150"
                                    Margin="0,8,0,0"
                                    IsVisible="{Binding CanStop}" />

                            <Grid Margin="0,10,0,0" IsVisible="{Binding IsCommentEnabled}">
                                <TextBox Text="{Binding CommentText}"
                                         Classes="comment"
                                         MaxLength="1000"
                                         AutomationProperties.Name="{loc:Loc Key=CommentPlaceholder}" />
                                <TextBlock Text="{loc:Loc Key=CommentPlaceholder}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           IsHitTestVisible="False"
                                           IsVisible="{Binding IsCommentEmpty}" />
                            </Grid>

                            <Border Classes="error"
                                    Margin="0,10,0,0"
                                    IsVisible="{Binding HasError}">
                                <TextBlock Text="{Binding ErrorMessage}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="card" Margin="0,12,0,0" Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{loc:Loc Key=Today}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TodayDateText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TodayTotalText}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="{Binding TodaySessionCountText}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding SparklineBars}"
                                      Height="44"
                                      VerticalAlignment="Bottom"
                                      Margin="18,0,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SparklineBarViewModel">
                                    <Border Classes="sparkbar"
                                            Classes.today="{Binding IsToday}"
                                            Height="{Binding Height}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=SessionsToday}"
                           Classes="section"
                           Margin="2,18,0,9" />

                <Border Classes="card" Padding="0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TodaySessions}"
                                      ItemTemplate="{StaticResource SessionRowTemplate}" />
                        <TextBlock Text="{loc:Loc Key=NoSessionsToday}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="20,22"
                                   IsVisible="{Binding IsEmpty}" />
                        <Border Classes="divider" />
                        <Button Content="{loc:Loc Key=AddManualEntry}"
                                Classes="link"
                                Command="{Binding AddManualCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,6" />
                    </StackPanel>
                </Border>

                <Border Classes="error"
                        Margin="0,12,0,0"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="HistoryScroll"
                      Grid.Row="1"
                      Margin="24,0,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsHistoryPage}">
            <StackPanel x:Name="HistoryContent" Margin="0,0,10,18">
                <TextBlock Text="{loc:Loc Key=HistoryTitle}" Classes="h1" />
                <TextBlock Text="{loc:Loc Key=HistorySubtitle}" Classes="subtitle" Margin="0,4,0,14" />

                <Border Classes="card" Padding="0" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,1,*,1,*">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="{loc:Loc Key=Today}" Classes="caption" />
                            <TextBlock Text="{Binding HistoryTodayText}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel Grid.Column="2" Margin="16,14">
                            <TextBlock Text="{loc:Loc Key=HistoryWeek}" Classes="caption" />
                            <TextBlock Text="{Binding HistoryWeekText}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" />
                        <StackPanel Grid.Column="4" Margin="16,14">
                            <TextBlock Text="{loc:Loc Key=HistoryTotal}" Classes="caption" />
                            <TextBlock Text="{Binding HistoryTotalText}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=Loading}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,10"
                           IsVisible="{Binding IsHistoryLoading}" />

                <ItemsControl ItemsSource="{Binding HistoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryGroupViewModel">
                            <Border Classes="card" Margin="0,0,0,12" Padding="0">
                                <Grid ColumnDefinitions="4,*">
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="2"
                                            Margin="0,18,0,18"
                                            IsVisible="{Binding IsToday}" />
                                    <StackPanel Grid.Column="1" Margin="16,14,8,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SessionCountText}"
                                                           Classes="caption"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TotalText}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Sessions}"
                                                      ItemTemplate="{StaticResource SessionRowTemplate}"
                                                      Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Loc Key=HistoryEmpty}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20,16,20,10"
                           IsVisible="{Binding IsHistoryEmpty}" />

                <Border Classes="error"
                        Margin="0,4,0,8"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" />
                </Border>

                <Button Content="{loc:Loc Key=LoadEarlier}"
                        Classes="link"
                        Command="{Binding LoadEarlierCommand}"
                        IsEnabled="{Binding CanLoadEarlier}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,8,24,14" ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Loc Key=PlatformsWindows}"
                       Classes="caption"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="pill" Padding="10,5">
                <TextBlock Text="{Binding HotkeyHintText}"
                           FontFamily="{DynamicResource MonoFontFamily}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
