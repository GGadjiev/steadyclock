<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteadyClock.Desktop.ViewModels"
        xmlns:controls="using:SteadyClock.Desktop.Views.Controls"
        xmlns:loc="using:SteadyClock.Desktop.Resources"
        x:Class="SteadyClock.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Loc Key=AppTitle}"
        Icon="avares://SteadyClock/Assets/app.ico"
        Width="540"
        Height="800"
        MinWidth="460"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="SessionRowTemplate" x:DataType="vm:SessionLineViewModel">
            <Border BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0">
                <Grid ColumnDefinitions="18,*,Auto,Auto">
                    <controls:TimelineRail Grid.Column="0"
                                           IsHitTestVisible="False"
                                           LineBrush="{DynamicResource TimelineBrush}"
                                           DotBrush="{DynamicResource SageBrush}"
                                           ShowTopConnector="{Binding ShowTopConnector}"
                                           ShowBottomConnector="{Binding ShowConnector}" />

                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,11,0,11">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding TimeRangeText}"
                                       FontSize="14.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <Border Classes="badge" IsVisible="{Binding HasBadge}">
                                <TextBlock Text="{Binding Badge}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Comment}"
                                   Classes="caption"
                                   IsVisible="{Binding HasComment}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationText}"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Right"
                               Margin="12,11,10,0" />

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Top"
                                Margin="0,7,0,0"
                                IsVisible="{Binding CanManage}">
                        <Button Classes="rowAction"
                                Command="{Binding EditCommand}"
                                AutomationProperties.Name="{Binding EditLabel}">
                            <ToolTip.Tip>
                                <TextBlock Text="{Binding EditLabel}" />
                            </ToolTip.Tip>
                            <Path Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  Data="M4,20L4,16L16,4L20,8L8,20Z M14,6L18,10" />
                        </Button>
                        <Button Classes="rowAction"
                                Command="{Binding DeleteCommand}"
                                AutomationProperties.Name="{Binding DeleteLabel}">
                            <ToolTip.Tip>
                                <TextBlock Text="{Binding DeleteLabel}" />
                            </ToolTip.Tip>
                            <Path Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  Data="M4,6H20 M9,6V4H15V6 M6,6V20H18V6 M10,10V16 M14,10V16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Margin="24,18,24,18" ColumnDefinitions="Auto,*,Auto">
            <Border Width="40"
                    Height="40"
                    CornerRadius="13"
                    Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Center">
                <Viewbox Width="25" Height="25">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="{DynamicResource AccentForegroundBrush}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              Data="M9,3H15 M12,3V5.5 M4.5,13A7.5,7.5 0 1,0 19.5,13A7.5,7.5 0 1,0 4.5,13 M12,13V8.5 M12,13L15.5,15" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="11,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Key=AppTitle}" Classes="brand" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="nav"
                        Content="{loc:Loc Key=HistoryTitle}"
                        Command="{Binding ShowHistoryCommand}"
                        IsVisible="{Binding IsTimerPage}" />
                <Button Classes="nav"
                        Content="{loc:Loc Key=Back}"
                        Command="{Binding ShowTimerCommand}"
                        IsVisible="{Binding IsHistoryPage}" />
                <Button Classes="icon"
                        Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="{loc:Loc Key=SettingsOpenTooltip}">
                    <ToolTip.Tip>
                        <TextBlock Text="{loc:Loc Key=SettingsOpenTooltip}" />
                    </ToolTip.Tip>
                    <Path Width="19"
                          Height="19"
                          Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          Data="M12.22,2H11.78A2,2 0 0,0 9.78,4V4.18A2,2 0 0,1 8.78,5.91L8.35,6.16A2,2 0 0,1 6.35,6.16L6.2,6.08A2,2 0 0,0 3.47,6.81L3.25,7.19A2,2 0 0,0 3.98,9.92L4.13,10.01A2,2 0 0,1 5.13,11.75V12.25A2,2 0 0,1 4.13,13.99L3.98,14.08A2,2 0 0,0 3.25,16.81L3.47,17.19A2,2 0 0,0 6.2,17.92L6.35,17.84A2,2 0 0,1 8.35,17.84L8.78,18.09A2,2 0 0,1 9.78,19.82V20A2,2 0 0,0 11.78,22H12.22A2,2 0 0,0 14.22,20V19.82A2,2 0 0,1 15.22,18.09L15.65,17.84A2,2 0 0,1 17.65,17.84L17.8,17.92A2,2 0 0,0 20.53,17.19L20.75,16.81A2,2 0 0,0 20.02,14.08L19.87,13.99A2,2 0 0,1 18.87,12.25V11.75A2,2 0 0,1 19.87,10.01L20.02,9.92A2,2 0 0,0 20.75,7.19L20.53,6.81A2,2 0 0,0 17.8,6.08L17.65,6.16A2,2 0 0,1 15.65,6.16L15.22,5.91A2,2 0 0,1 14.22,4.18V4A2,2 0 0,0 12.22,2Z M15,12A3,3 0 1,1 9,12A3,3 0 1,1 15,12Z" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="TimerScroll"
                      Grid.Row="1"
                      Margin="24,0,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsTimerPage}">
            <StackPanel x:Name="TimerContent" Margin="0,0,10,18">
                <Border Classes="card" Padding="20,16,20,18" ClipToBounds="True">
                    <Grid>
                        <controls:RingsBackground RingBrush="{DynamicResource RingBrush}"
                                                  Opacity="0.30"
                                                  IsHitTestVisible="False" />
                        <StackPanel Margin="4,0">
                            <TextBlock x:Name="TimerTextBlock"
                                       Text="{Binding TimerText}"
                                       Classes="timer" />
                            <Border Height="28"
                                    HorizontalAlignment="Center"
                                    Margin="0,7,0,0"
                                    Padding="13,0"
                                    CornerRadius="999"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Background}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="7"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="7"
                                             Height="7"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Dot}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding PrimaryActionCommand}"
                                    Classes="primary"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <PathIcon Width="13"
                                              Height="14"
                                              Data="{Binding PrimaryActionIconData}" />
                                    <TextBlock Text="{Binding PrimaryActionText}" />
                                </StackPanel>
                            </Button>

                            <Button Content="{loc:Loc Key=Stop}"
                                    Command="{Binding StopCommand}"
                                    Classes="secondary"
                                    HorizontalAlignment="Center"
                                    MinWidth="150"
                                    Margin="0,8,0,0"
                                    IsVisible="{Binding CanStop}" />

                            <Grid Margin="0,10,0,0" IsVisible="{Binding IsCommentEnabled}">
                                <TextBox Text="{Binding CommentText}"
                                         Classes="comment"
                                         MaxLength="1000"
                                         AutomationProperties.Name="{loc:Loc Key=CommentPlaceholder}" />
                                <TextBlock Text="{loc:Loc Key=CommentPlaceholder}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           IsHitTestVisible="False"
                                           IsVisible="{Binding IsCommentEmpty}" />
                            </Grid>

                            <Border Classes="error"
                                    Margin="0,10,0,0"
                                    IsVisible="{Binding HasError}">
                                <TextBlock Text="{Binding ErrorMessage}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="card" Margin="0,12,0,0" Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{loc:Loc Key=Today}" FontSize="16.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TodayDateText}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TodayTotalText}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding TodaySessionCountText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding SparklineBars}"
                                      Height="56"
                                      VerticalAlignment="Bottom"
                                      Margin="18,0,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SparklineBarViewModel">
                                    <Border Classes="sparkbar"
                                            Classes.today="{Binding IsToday}"
                                            Height="{Binding Height}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=SessionsToday}"
                           Classes="section"
                           Margin="2,18,0,9" />

                <Border Classes="card" Padding="0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TodaySessions}"
                                      ItemTemplate="{StaticResource SessionRowTemplate}" />
                        <TextBlock Text="{loc:Loc Key=NoSessionsToday}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="20,22"
                                   IsVisible="{Binding IsEmpty}" />
                        <Border Classes="divider" />
                        <Button Classes="link"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Command="{Binding AddManualCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,6">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      Data="M12,5V19 M5,12H19" />
                                <TextBlock Text="{loc:Loc Key=AddManualEntry}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Classes="error"
                        Margin="0,12,0,0"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="HistoryScroll"
                      Grid.Row="1"
                      Margin="24,0,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsHistoryPage}">
            <StackPanel x:Name="HistoryContent" Margin="0,0,10,18">
                <TextBlock Text="{loc:Loc Key=HistoryTitle}" Classes="h1" />
                <TextBlock Text="{loc:Loc Key=HistorySubtitle}" Classes="subtitle" Margin="0,4,0,14" />

                <Border Classes="card" Padding="0" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,1,*,1,*">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="{loc:Loc Key=Today}" Classes="caption" />
                            <TextBlock Text="{Binding HistoryTodayText}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel Grid.Column="2" Margin="16,14">
                            <TextBlock Text="{loc:Loc Key=HistoryWeek}" Classes="caption" />
                            <TextBlock Text="{Binding HistoryWeekText}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" />
                        <StackPanel Grid.Column="4" Margin="16,14">
                            <TextBlock Text="{loc:Loc Key=HistoryTotal}" Classes="caption" />
                            <TextBlock Text="{Binding HistoryTotalText}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=Loading}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,10"
                           IsVisible="{Binding IsHistoryLoading}" />

                <ItemsControl ItemsSource="{Binding HistoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryGroupViewModel">
                            <Border Classes="card" Margin="0,0,0,12" Padding="0">
                                <Grid ColumnDefinitions="4,*">
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="2"
                                            Margin="0,18,0,18"
                                            IsVisible="{Binding IsToday}" />
                                    <StackPanel Grid.Column="1" Margin="14,14,12,0">
                                        <Grid ColumnDefinitions="18,*,Auto" Margin="14,0,0,0">
                                            <controls:TimelineRail Grid.Column="0"
                                                                   IsHitTestVisible="False"
                                                                   DotDiameter="8"
                                                                   DotCenterY="10.5"
                                                                   ShowTopConnector="False"
                                                                   ShowBottomConnector="True"
                                                                   Margin="0,0,0,-6"
                                                                   LineBrush="{DynamicResource TimelineBrush}"
                                                                   DotBrush="{DynamicResource SageBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SessionCountText}"
                                                           Classes="caption"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TotalText}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Sessions}"
                                                      ItemTemplate="{StaticResource SessionRowTemplate}"
                                                      Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Loc Key=HistoryEmpty}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20,16,20,10"
                           IsVisible="{Binding IsHistoryEmpty}" />

                <Border Classes="error"
                        Margin="0,4,0,8"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" />
                </Border>

                <Button Content="{loc:Loc Key=LoadEarlier}"
                        Classes="link"
                        Command="{Binding LoadEarlierCommand}"
                        IsEnabled="{Binding CanLoadEarlier}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
