<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteadyClock.Desktop.ViewModels"
        xmlns:loc="using:SteadyClock.Desktop.Resources"
        x:Class="SteadyClock.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Loc Key=AppTitle}"
        Icon="avares://SteadyClock/Assets/app.ico"
        Width="424"
        Height="680"
        MinWidth="390"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="SessionRowTemplate" x:DataType="vm:SessionLineViewModel">
            <Border Classes="session">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding TimeRangeText}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Classes="badge" IsVisible="{Binding HasBadge}">
                                <TextBlock Text="{Binding Badge}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Comment}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   IsVisible="{Binding HasComment}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DurationText}"
                                   Classes="mono"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="2"
                                    Margin="0,3,0,0"
                                    IsVisible="{Binding CanManage}">
                            <Button Classes="rowAction"
                                    Command="{Binding EditCommand}"
                                    AutomationProperties.Name="{Binding EditLabel}">
                                <ToolTip.Tip>
                                    <TextBlock Text="{Binding EditLabel}" Foreground="White" />
                                </ToolTip.Tip>
                                <PathIcon Width="12"
                                          Height="12"
                                          Foreground="{Binding $parent[Button].Foreground}"
                                          Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25Z" />
                            </Button>
                            <Button Classes="rowAction"
                                    Command="{Binding DeleteCommand}"
                                    AutomationProperties.Name="{Binding DeleteLabel}">
                                <ToolTip.Tip>
                                    <TextBlock Text="{Binding DeleteLabel}" Foreground="White" />
                                </ToolTip.Tip>
                                <PathIcon Width="12"
                                          Height="12"
                                          Foreground="{Binding $parent[Button].Foreground}"
                                          Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Margin="20,16,20,8" ColumnDefinitions="Auto,*,Auto">
            <Image Width="28"
                   Height="28"
                   VerticalAlignment="Center"
                   Source="avares://SteadyClock/Assets/app.png" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeaderTitle}" Classes="title" />
                <TextBlock Text="{loc:Loc Key=CrossPlatformPreview}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,1,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="nav"
                        Content="{loc:Loc Key=HistoryTitle}"
                        Command="{Binding ShowHistoryCommand}"
                        IsVisible="{Binding IsTimerPage}" />
                <Button Classes="nav"
                        Content="{loc:Loc Key=Back}"
                        Command="{Binding ShowTimerCommand}"
                        IsVisible="{Binding IsHistoryPage}" />
                <Button Classes="nav"
                        Content="⚙"
                        Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="{loc:Loc Key=SettingsOpenTooltip}">
                    <ToolTip.Tip>
                        <TextBlock Text="{loc:Loc Key=SettingsOpenTooltip}" Foreground="White" />
                    </ToolTip.Tip>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="20,2,20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsTimerPage}">
            <StackPanel Margin="0,0,12,22">
                <Border Classes="card" Padding="18,20,18,16">
                    <StackPanel>
                        <TextBlock Text="{Binding TimerText}" Classes="timer" />
                        <Border HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Background}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Dot}" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                            </StackPanel>
                        </Border>

                        <Button Content="{Binding PrimaryActionText}"
                                Command="{Binding PrimaryActionCommand}"
                                Classes="primary"
                                Width="240"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0" />
                        <Button Content="{loc:Loc Key=Stop}"
                                Command="{Binding StopCommand}"
                                Classes="secondary"
                                Width="240"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                IsVisible="{Binding CanStop}" />
                        <Grid Margin="0,12,0,0"
                              IsVisible="{Binding IsCommentEnabled}">
                            <TextBox Text="{Binding CommentText}"
                                     MaxLength="1000"
                                     FontSize="12.5"
                                     AutomationProperties.Name="{loc:Loc Key=CommentPlaceholder}" />
                            <TextBlock Text="{loc:Loc Key=CommentPlaceholder}"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding IsCommentEmpty}" />
                        </Grid>
                        <Border Classes="error"
                                Margin="0,12,0,0"
                                IsVisible="{Binding HasError}">
                            <TextBlock Text="{Binding ErrorMessage}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="0,12,0,0" Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=Today}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TodayDateText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TodaySessionCountText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TodayTotalText}"
                                       Classes="mono"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{loc:Loc Key=SessionTotalLabel}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=SessionsToday}"
                           Classes="section"
                           Margin="2,18,0,9" />

                <ItemsControl ItemsSource="{Binding TodaySessions}"
                              ItemTemplate="{StaticResource SessionRowTemplate}" />

                <TextBlock Text="{loc:Loc Key=NoSessionsToday}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20,10,20,6"
                           IsVisible="{Binding IsEmpty}" />

                <Button Content="{loc:Loc Key=AddManualEntry}"
                        Classes="link"
                        Command="{Binding AddManualCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0" />

                <TextBlock Text="{loc:Loc Key=BetaFoundationNotice}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="8,10,8,0" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1"
                      Margin="20,2,20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsHistoryPage}">
            <StackPanel Margin="0,0,12,22">
                <TextBlock Text="{loc:Loc Key=Loading}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,10"
                           IsVisible="{Binding IsHistoryLoading}" />

                <ItemsControl ItemsSource="{Binding HistoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryGroupViewModel">
                            <Border Classes="card" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DateText}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SessionCountText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalText}"
                                                   Classes="mono"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Sessions}"
                                                  ItemTemplate="{StaticResource SessionRowTemplate}"
                                                  Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Loc Key=HistoryEmpty}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20,16,20,10"
                           IsVisible="{Binding IsHistoryEmpty}" />

                <Border Classes="error"
                        Margin="0,4,0,8"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" />
                </Border>

                <Button Content="{loc:Loc Key=LoadEarlier}"
                        Classes="link"
                        Command="{Binding LoadEarlierCommand}"
                        IsEnabled="{Binding CanLoadEarlier}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,4" />

                <Button Content="{loc:Loc Key=AddManualEntry}"
                        Classes="link"
                        Command="{Binding AddManualCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />

                <TextBlock Text="{loc:Loc Key=BetaFoundationNotice}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="8,10,8,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
