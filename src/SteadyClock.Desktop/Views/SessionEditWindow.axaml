<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteadyClock.Desktop.ViewModels"
        xmlns:loc="using:SteadyClock.Desktop.Resources"
        x:Class="SteadyClock.Desktop.Views.SessionEditWindow"
        x:DataType="vm:SessionEditViewModel"
        Title="{Binding Title}"
        Width="480"
        Height="590"
        MinWidth="420"
        MinHeight="500"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="*,Auto,Auto" Margin="24,20,24,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" />

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Loc Key=DateLabel}" Classes="caption" />
                            <TextBox Text="{Binding DateText}"
                                     PlaceholderText="{loc:Loc Key=DateFormatExample}"
                                     Width="170"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Loc Key=DateLabel}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,14,*">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{loc:Loc Key=StartTimeLabel}" Classes="caption" />
                                <TextBox Text="{Binding StartTimeText}"
                                         PlaceholderText="{loc:Loc Key=TimeFormatExample}"
                                         AutomationProperties.Name="{loc:Loc Key=StartTimeLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="{loc:Loc Key=EndTimeLabel}" Classes="caption" />
                                <TextBox Text="{Binding EndTimeText}"
                                         PlaceholderText="{loc:Loc Key=TimeFormatExample}"
                                         AutomationProperties.Name="{loc:Loc Key=EndTimeLabel}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Loc Key=EndTimeHint}"
                                   Classes="caption"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DurationPreview}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding AutoConversionNote}"
                                   Classes="caption"
                                   IsVisible="{Binding IsAutomaticExisting}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{loc:Loc Key=CommentLabel}" Classes="caption" />
                        <TextBox Text="{Binding Comment}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="96"
                                 MaxLength="1000"
                                 AutomationProperties.Name="{loc:Loc Key=CommentLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Classes="error"
                Margin="0,12,0,0"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" />
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,14"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="{Binding CancelButtonText}"
                        Command="{Binding CancelCommand}"
                        Classes="secondary"
                        MinWidth="104" />
                <Button Content="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        Classes="primary"
                        MinWidth="124"
                        IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

