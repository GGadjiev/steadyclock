<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteadyClock.Desktop.ViewModels"
        xmlns:loc="using:SteadyClock.Desktop.Resources"
        x:Class="SteadyClock.Desktop.Views.SessionEditWindow"
        x:DataType="vm:SessionEditViewModel"
        Title="{Binding Title}"
        Width="520"
        Height="660"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Classes="card"
            Margin="16"
            Padding="24,20,24,18">
        <Grid RowDefinitions="*,Auto">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" Classes="h1" />
                        <TextBlock Text="{Binding NewEntrySubtitle}" Classes="subtitle" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc Key=DateLabel}" Classes="label" />
                        <TextBox Text="{Binding DateText}"
                                 PlaceholderText="{loc:Loc Key=DateFormatExample}"
                                 AutomationProperties.Name="{loc:Loc Key=DateLabel}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,14,*">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc Key=StartTimeLabel}" Classes="label" />
                            <TextBox Text="{Binding StartTimeText}"
                                     PlaceholderText="{loc:Loc Key=TimeFormatExample}"
                                     AutomationProperties.Name="{loc:Loc Key=StartTimeLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="{loc:Loc Key=EndTimeLabel}" Classes="label" />
                            <TextBox Text="{Binding EndTimeText}"
                                     PlaceholderText="{loc:Loc Key=TimeFormatExample}"
                                     AutomationProperties.Name="{loc:Loc Key=EndTimeLabel}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="12"
                            Padding="14,11">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Loc Key=DurationLabel}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DurationValue}"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding EntryHistoryNote}" Classes="caption" />
                    <TextBlock Text="{loc:Loc Key=EndTimeHint}" Classes="caption" />
                    <TextBlock Text="{Binding AutoConversionNote}"
                               Classes="caption"
                               IsVisible="{Binding IsAutomaticExisting}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc Key=CommentLabel}" Classes="label" />
                        <TextBox Text="{Binding Comment}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="96"
                                 MaxLength="1000"
                                 PlaceholderText="{loc:Loc Key=CommentPlaceholderShort}"
                                 AutomationProperties.Name="{loc:Loc Key=CommentLabel}" />
                    </StackPanel>

                    <Border Classes="error" IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="{Binding CancelButtonText}"
                            Command="{Binding CancelCommand}"
                            Classes="secondary"
                            MinWidth="104" />
                    <Button Content="{Binding SaveButtonText}"
                            Command="{Binding SaveCommand}"
                            Classes="primary"
                            MinWidth="124"
                            IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
