<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SteadyClock.Desktop.Resources"
        x:Class="SteadyClock.Desktop.Views.ToastWindow"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Border Classes="card"
            Margin="12"
            Padding="18,16,16,16"
            BoxShadow="0 6 22 0 #26000000">
        <Grid RowDefinitions="Auto,Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TitleText"
                           FontSize="15.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="rowAction"
                        Content="×"
                        ToolTip.Tip="{loc:Loc Key=Close}"
                        AutomationProperties.Name="{loc:Loc Key=Close}"
                        Click="CloseClicked" />
            </Grid>
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       FontSize="13.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,10,0" />
            <StackPanel x:Name="ActionsPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,14,0,0">
                <Button x:Name="SecondaryButton"
                        Classes="secondary"
                        Height="34"
                        MinWidth="88"
                        FontSize="12.5"
                        Click="SecondaryClicked" />
                <Button x:Name="PrimaryButton"
                        Classes="primary"
                        Height="34"
                        MinWidth="104"
                        FontSize="12.5"
                        Click="PrimaryClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

