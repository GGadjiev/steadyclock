<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:SteadyClock.Desktop.Converters"
        xmlns:controls="using:SteadyClock.Desktop.Views.Controls">
    <Styles.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush">#F3F6F4</SolidColorBrush>
        <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="CardBorderBrush">#E2E9E5</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush">#1C2925</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondaryBrush">#66746F</SolidColorBrush>
        <SolidColorBrush x:Key="TextTertiaryBrush">#6F7D78</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#2F7A70</SolidColorBrush>
        <SolidColorBrush x:Key="AccentHoverBrush">#286A61</SolidColorBrush>
        <SolidColorBrush x:Key="AccentSoftBrush">#E6F2EF</SolidColorBrush>
        <SolidColorBrush x:Key="InputBorderBrush">#D6DFDA</SolidColorBrush>
        <SolidColorBrush x:Key="DividerBrush">#EBF0ED</SolidColorBrush>
        <SolidColorBrush x:Key="DangerBrush">#AE3D37</SolidColorBrush>
        <SolidColorBrush x:Key="DangerSoftBrush">#FBEDEB</SolidColorBrush>
        <SolidColorBrush x:Key="HoverSurfaceBrush">#EBF1EE</SolidColorBrush>

        <SolidColorBrush x:Key="StatusRunningBackgroundBrush">#E5F4EC</SolidColorBrush>
        <SolidColorBrush x:Key="StatusRunningForegroundBrush">#176548</SolidColorBrush>
        <SolidColorBrush x:Key="StatusRunningDotBrush">#24865F</SolidColorBrush>
        <SolidColorBrush x:Key="StatusPausedManualBackgroundBrush">#FBF1DE</SolidColorBrush>
        <SolidColorBrush x:Key="StatusPausedManualForegroundBrush">#835612</SolidColorBrush>
        <SolidColorBrush x:Key="StatusPausedManualDotBrush">#B77B22</SolidColorBrush>
        <SolidColorBrush x:Key="StatusPausedIdleBackgroundBrush">#FCEFE4</SolidColorBrush>
        <SolidColorBrush x:Key="StatusPausedIdleForegroundBrush">#844F1E</SolidColorBrush>
        <SolidColorBrush x:Key="StatusPausedIdleDotBrush">#BD6526</SolidColorBrush>
        <SolidColorBrush x:Key="StatusStoppedBackgroundBrush">#EDF1EF</SolidColorBrush>
        <SolidColorBrush x:Key="StatusStoppedForegroundBrush">#5D6A66</SolidColorBrush>
        <SolidColorBrush x:Key="StatusStoppedDotBrush">#7A8783</SolidColorBrush>

        <conv:StatusToBrushConverter x:Key="StatusBrush" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI, SF Pro Text, Cantarell, Noto Sans" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Opacity" Value="0.82" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.timer">
        <Setter Property="FontFamily" Value="Consolas, Menlo, DejaVu Sans Mono" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas, Menlo, DejaVu Sans Mono" />
    </Style>

    <Style Selector="Border.session">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.rowAction">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.rowAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.link:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="#B9C8C1" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="controls|HotkeyTextBox">
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="CheckBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="#9A342F" />
        <Setter Property="BorderBrush" Value="#9A342F" />
    </Style>

    <Style Selector="Border.error">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style Selector="Border.error TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#24312D" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ToolTip TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ToolTip /template/ ContentPresenter">
        <Setter Property="Foreground" Value="White" />
    </Style>
</Styles>
